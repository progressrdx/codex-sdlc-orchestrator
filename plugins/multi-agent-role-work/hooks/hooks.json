{
  "description": "Keep active formal workflows stage-aware and prevent accidental source edits outside development stages.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/workflow_guard.py\" guard",
            "timeout": 5,
            "statusMessage": "Enforcing SDLC stage boundary"
          }
        ]
      }
    ]
  }
}
